# Copy this file to .env.local and fill in your Supabase project's values.
# Found in Supabase dashboard → Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — Supabase dashboard → Project Settings → API → service_role key.
# NEVER prefix this with NEXT_PUBLIC_ or it becomes visible in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only secret, used by the monthly reset cron route.
# Set this same value as the CRON_SECRET env var in Vercel project settings,
# and it must match the Authorization header Vercel Cron sends.
CRON_SECRET=generate-a-random-string-here
